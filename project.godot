[layer_names]

3d_render/layer_1="World"
3d_render/layer_2="Occlusion"
3d_render/layer_3="Environment"
3d_render/layer_4="Player"
3d_render/layer_5="Enemy"
3d_render/layer_6="PlayerAttack"
3d_render/layer_7="EnemyAttack"

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
camera/depth_of_field/depth_of_field_bokeh_shape=0
anti_aliasing/quality/msaa_3d=1
textures/decals/filter=2
environment/volumetric_fog/volume_size=128
2d/snap/snap_2d_transforms_to_pixel=true

[shader_globals]

player_world_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
camera_world_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
