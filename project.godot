; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Splintervale"
run/main_scene="uid://cru0wcsvl36l"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/game/game_manager.gd"
SceneTransition="*res://scripts/game/scene_transition.gd"
Hud="res://menu/hud/hud.tscn"
GameEffects="*res://scripts/game/game_effects.gd"
UIUtils="*res://menu/glassmorphism/ui_utils.gd"
PauseMenu="*res://menu/pause/pause_menu.tscn"
LoadingScreen="*res://menu/loadingscreen/LoadingScreen.tscn"
GameOverScreen="*res://menu/gameover/GameOverScreen.tscn"
WorldAmbience="*res://scripts/game/world_ambience.gd"
FogManager="*res://assets/vfx/environment/FogZone/fog_manager.gd"
MusicManager="*res://assets/vfx/music/MusicManager.gd"
DialogueManager="*res://scripts/game/dialogue_manager.gd"
MapManager="*res://scripts/map/map_manager.gd"
QuestManager="*res://scripts/game/quest_manager.gd"
InventoryManager="*res://scripts/game/inventory_manager.gd"
VistaManager="*res://assets/vfx/environment/VistaZone/vista_manager.gd"
PlayerManager="*res://scripts/game/player_manager.gd"
AudioPool="*res://scripts/game/audio_pool.gd"
Settings="*res://scripts/settings/settings.gd"
TreeOcclusionManager="*res://scripts/tree_occlusion_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Splintervale"

[editor_plugins]

enabled=PackedStringArray("res://addons/fence_builder/plugin.cfg", "res://addons/grass_editor/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/tree_painter/plugin.cfg", "res://addons/zylann.hterrain/plugin.cfg")

