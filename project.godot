; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Splintervale"
run/main_scene="uid://bys0qx7akx3qb"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameEffects="*res://scripts/game/game_effects.gd"
Hud="res://menu/hud/hud.tscn"
GameManager="*res://scripts/game/game_manager.gd"
UIUtils="*res://menu/glassmorphism/ui_utils.gd"
PauseMenu="*res://menu/pause/pause_menu.tscn"
LoadingScreen="*res://menu/loadingscreen/LoadingScreen.tscn"
GameOverScreen="*res://menu/gameover/GameOverScreen.tscn"
WorldAmbience="*res://scripts/game/world_ambience.gd"
FogManager="*res://assets/sfx/environment/FogZone/fog_manager.gd"
MusicManager="*res://assets/sfx/music/MusicManager.gd"
DialogueManager="*res://scripts/game/dialogue_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Splintervale"

[editor_plugins]

enabled=PackedStringArray("res://addons/proton_scatter/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/vegetation_painter/plugin.cfg", "res://addons/zylann.hterrain/plugin.cfg")

