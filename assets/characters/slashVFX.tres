code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 BaseColor : source_color;
uniform float progress : hint_range(-1.0, 1.0) = 0.0;
uniform sampler2D BaseTexture : filter_nearest, repeat_disable;
uniform vec4 HighlightColor : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform sampler2D HighlightTexture : filter_nearest, repeat_disable;
uniform sampler2D DissolveTexture;
uniform float DissolveValue : hint_range(0.0, 1.0) = 0.0;



void fragment() {
// ColorParameter:10
	vec4 n_out10p0 = BaseColor;


// VectorDecompose:5
	vec3 n_in5p0 = vec3(0.00000, 0.00000, 0.00000);
	float n_out5p0 = n_in5p0.x;
	float n_out5p1 = n_in5p0.y;
	float n_out5p2 = n_in5p0.z;


// FloatParameter:6
	float n_out6p0 = progress;


// FloatOp:7
	float n_out7p0 = n_out5p0 - n_out6p0;


// VectorCompose:8
	vec2 n_out8p0 = vec2(n_out7p0, n_out5p1);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(BaseTexture, n_out8p0);


// VectorOp:11
	vec4 n_out11p0 = n_out10p0 * n_out3p0;


// ColorParameter:16
	vec4 n_out16p0 = HighlightColor;


	vec4 n_out13p0;
// Texture2D:13
	n_out13p0 = texture(HighlightTexture, n_out8p0);


// VectorOp:17
	vec4 n_out17p0 = n_out16p0 * n_out13p0;


// VectorDecompose:15
	float n_out15p0 = n_out13p0.x;
	float n_out15p1 = n_out13p0.y;
	float n_out15p2 = n_out13p0.z;
	float n_out15p3 = n_out13p0.w;


// Mix:14
	vec4 n_out14p0 = mix(n_out11p0, n_out17p0, vec4(n_out15p3));


// VectorDecompose:9
	float n_out9p0 = n_out3p0.x;
	float n_out9p1 = n_out3p0.y;
	float n_out9p2 = n_out3p0.z;
	float n_out9p3 = n_out3p0.w;


// FloatFunc:24
	float n_out24p0 = 1.0 - n_out9p3;


// FloatOp:25
	float n_out25p0 = n_out24p0 * n_out15p3;


// FloatOp:26
	float n_out26p0 = n_out9p3 + n_out25p0;


// Clamp:27
	float n_in27p1 = 0.00000;
	float n_in27p2 = 1.00000;
	float n_out27p0 = clamp(n_out26p0, n_in27p1, n_in27p2);


	vec4 n_out19p0;
// Texture2D:19
	n_out19p0 = texture(DissolveTexture, UV);


// FloatParameter:20
	float n_out20p0 = DissolveValue;


// FloatOp:21
	float n_out21p0 = n_out19p0.x - n_out20p0;


// Clamp:22
	float n_in22p1 = 0.00000;
	float n_in22p2 = 1.00000;
	float n_out22p0 = clamp(n_out21p0, n_in22p1, n_in22p2);


// FloatOp:23
	float n_out23p0 = n_out27p0 * n_out22p0;


// Output:0
	ALBEDO = vec3(n_out14p0.xyz);
	ALPHA = n_out23p0;


}
