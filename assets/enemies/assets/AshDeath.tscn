[gd_scene format=3]

[ext_resource type="Script" uid="uid://ct6tv403ghw2" path="res://assets/enemies/assets/ash_death.gd" id="1_script"]
[ext_resource type="Shader" uid="uid://buc3ae5do7q3e" path="res://assets/enemies/assets/dissolve_ash.gdshader" id="2_ghost_shader"]

[sub_resource type="FastNoiseLite" id="ghost_noise_fnl"]
noise_type = 1
frequency = 0.04

[sub_resource type="NoiseTexture2D" id="ghost_noise_tex"]
seamless = true
noise = SubResource("ghost_noise_fnl")

[sub_resource type="QuadMesh" id="ghost_mesh"]
size = Vector2(1, 1)

[sub_resource type="ShaderMaterial" id="ghost_mat"]
shader = ExtResource("2_ghost_shader")
shader_parameter/hframes = 10
shader_parameter/vframes = 10
shader_parameter/frame = 0
shader_parameter/flip_h = false
shader_parameter/dissolve = 0.0
shader_parameter/edge_width = 0.04
shader_parameter/dissolve_pixel_resolution = 64.0
shader_parameter/white_mix = 0.0
shader_parameter/black_mix = 0.0
shader_parameter/sprite_modulate = Color(1, 1, 1, 1)
shader_parameter/edge_color = Color(0.7, 0.2, 1, 1)
shader_parameter/emission_strength = 0.12
shader_parameter/wind_dir = Vector2(1, -0.35)
shader_parameter/wind_skew = 0.0
shader_parameter/fade_in = 0.0
shader_parameter/z_bias = 0.01
shader_parameter/noise_tex = SubResource("ghost_noise_tex")

; === Soft Circle Textures ===
[sub_resource type="Gradient" id="circle_grad"]
offsets = PackedFloat32Array(0, 0.6, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.7, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="soft_circle_tex"]
gradient = SubResource("circle_grad")
width = 32
height = 32
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1.0, 0.5)

[sub_resource type="Gradient" id="very_soft_grad"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="very_soft_circle_tex"]
gradient = SubResource("very_soft_grad")
width = 48
height = 48
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1.0, 0.5)

; === FLAKES (Sphere emission, hoher Spread, mehr Velocity-Variation) ===
[sub_resource type="Gradient" id="flake_gradient"]
offsets = PackedFloat32Array(0, 0.2, 0.7, 1)
colors = PackedColorArray(0.12, 0.1, 0.13, 0.85, 0.1, 0.08, 0.11, 0.75, 0.05, 0.04, 0.06, 0.35, 0.03, 0.02, 0.04, 0)

[sub_resource type="GradientTexture1D" id="flake_ramp"]
gradient = SubResource("flake_gradient")

[sub_resource type="ParticleProcessMaterial" id="flake_proc"]
emission_shape = 1
emission_sphere_radius = 0.12
direction = Vector3(0.5, 0.5, 0)
spread = 180.0
initial_velocity_min = 0.15
initial_velocity_max = 0.7
angular_velocity_min = -180.0
angular_velocity_max = 180.0
gravity = Vector3(0, 0.2, 0)
damping_min = 0.5
damping_max = 1.6
scale_min = 0.4
scale_max = 1.1
color_ramp = SubResource("flake_ramp")
turbulence_enabled = true
turbulence_noise_strength = 0.8
turbulence_noise_scale = 2.0

[sub_resource type="StandardMaterial3D" id="flake_mat"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_texture = SubResource("soft_circle_tex")
billboard_mode = 1
billboard_keep_scale = true

[sub_resource type="QuadMesh" id="flake_quad"]
size = Vector2(0.025, 0.025)
material = SubResource("flake_mat")

; === EMBERS (Sphere emission, breit gestreut nach oben) ===
[sub_resource type="Gradient" id="ember_gradient"]
offsets = PackedFloat32Array(0, 0.3, 0.7, 1)
colors = PackedColorArray(0.7, 0.3, 0.9, 1, 0.6, 0.2, 0.8, 0.9, 0.35, 0.1, 0.5, 0.55, 0.15, 0.04, 0.2, 0)

[sub_resource type="GradientTexture1D" id="ember_ramp"]
gradient = SubResource("ember_gradient")

[sub_resource type="ParticleProcessMaterial" id="ember_proc"]
emission_shape = 1
emission_sphere_radius = 0.09
direction = Vector3(0.3, 1.0, 0)
spread = 90.0
initial_velocity_min = 0.2
initial_velocity_max = 0.6
gravity = Vector3(0, 0.25, 0)
damping_min = 0.4
damping_max = 1.0
scale_min = 0.3
scale_max = 0.7
color_ramp = SubResource("ember_ramp")
turbulence_enabled = true
turbulence_noise_strength = 0.6
turbulence_noise_scale = 2.5

[sub_resource type="StandardMaterial3D" id="ember_mat"]
transparency = 1
shading_mode = 0
blend_mode = 1
vertex_color_use_as_albedo = true
albedo_texture = SubResource("soft_circle_tex")
billboard_mode = 1
emission_enabled = true
emission = Color(0.6, 0.15, 1, 1)
emission_energy_multiplier = 1.0

[sub_resource type="QuadMesh" id="ember_quad"]
size = Vector2(0.022, 0.022)
material = SubResource("ember_mat")

; === SMOKE (Sphere emission, langsam, eng) ===
[sub_resource type="Gradient" id="smoke_gradient"]
offsets = PackedFloat32Array(0, 0.2, 0.7, 1)
colors = PackedColorArray(0.15, 0.1, 0.17, 0, 0.17, 0.11, 0.19, 0.3, 0.1, 0.06, 0.13, 0.15, 0.04, 0.02, 0.07, 0)

[sub_resource type="GradientTexture1D" id="smoke_ramp"]
gradient = SubResource("smoke_gradient")

[sub_resource type="Curve" id="smoke_scale_curve"]
_data = [Vector2(0, 0.3), 0, 0, 0, 0, Vector2(0.5, 0.8), 0, 0, 0, 0, Vector2(1, 1.0), 0, 0, 0, 0]
point_count = 3

[sub_resource type="CurveTexture" id="smoke_scale_tex"]
curve = SubResource("smoke_scale_curve")

[sub_resource type="ParticleProcessMaterial" id="smoke_proc"]
emission_shape = 1
emission_sphere_radius = 0.07
direction = Vector3(0.2, 1.0, 0)
spread = 40.0
initial_velocity_min = 0.08
initial_velocity_max = 0.22
gravity = Vector3(0, 0.25, 0)
damping_min = 0.3
damping_max = 0.6
scale_min = 1.2
scale_max = 2.0
scale_curve = SubResource("smoke_scale_tex")
color_ramp = SubResource("smoke_ramp")
turbulence_enabled = true
turbulence_noise_strength = 0.5
turbulence_noise_scale = 1.8

[sub_resource type="StandardMaterial3D" id="smoke_mat"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_texture = SubResource("very_soft_circle_tex")
billboard_mode = 1

[sub_resource type="QuadMesh" id="smoke_quad"]
size = Vector2(0.09, 0.09)
material = SubResource("smoke_mat")

; === Scene Tree ===
; randomness auf alle Particles erhoeht (0.4 -> 0.7), explosiveness leicht
; gestaffelt - jeder Layer spawnt unregelmaessig, nicht wie ein Burst-Slap.
[node name="AshDeath" type="Node3D"]
script = ExtResource("1_script")

[node name="Ghost" type="MeshInstance3D" parent="."]
mesh = SubResource("ghost_mesh")
material_override = SubResource("ghost_mat")

[node name="Smoke" type="GPUParticles3D" parent="."]
emitting = false
amount = 2
lifetime = 2.0
one_shot = true
explosiveness = 0.0
randomness = 0.8
process_material = SubResource("smoke_proc")
draw_pass_1 = SubResource("smoke_quad")

[node name="Flakes" type="GPUParticles3D" parent="."]
emitting = false
amount = 5
lifetime = 1.4
one_shot = true
explosiveness = 0.0
randomness = 0.7
process_material = SubResource("flake_proc")
draw_pass_1 = SubResource("flake_quad")

[node name="Embers" type="GPUParticles3D" parent="."]
emitting = false
amount = 2
lifetime = 0.9
one_shot = true
explosiveness = 0.2
randomness = 0.6
process_material = SubResource("ember_proc")
draw_pass_1 = SubResource("ember_quad")

[node name="DeathLight" type="OmniLight3D" parent="."]
light_color = Color(0.7, 0.2, 1, 1)
light_energy = 0.0
light_specular = 0.5
shadow_enabled = false
omni_range = 2.0
omni_attenuation = 2.0
