.0920724, 0, -0.02308917, 1.02051, 0, -0.38882083, 0.16023706, -1.0562692, 0, -0.18181914, -0.78315866, 0, 1.0718035, 0, -0.02308917, 0.18181914, 0, -1.0562692, 0.3159415, -0.27632305, 0, -0.8313237, -0.35716677, 0, 0.8760442, 0, -0.02308917, 0.8313237, 0, -0.27632305, -0.44409582, -0.8055028, 0, 0.4396583, -0.9557563, 0, 0.91767865, 0, -0.02308917, -0.4396583, 0, -0.8055028, -0.17601642, -0.9016073, 0, -0.69619423, -0.8720736, 0, 1.1391146, 0, -0.02308917, 0.69619423, 0, -0.9016073, -0.3176399, -0.6043421, 0, -0.8840297, 0.0457052, 0, 1.0708585, 0, -0.02308917, 0.8840297, 0, -0.6043421, 0.27488622, -0.23960917, 0, -0.89969903, -0.14292145, 0, 0.931059, 0, -0.02308917, 0.89969903, 0, -0.23960917, -0.3266276, -0.99769974, 0, -0.060155876, -0.81636405, 0, 0.9995116, 0, -0.02308917, 0.060155876, 0, -0.99769974, -0.77510375, -0.7344714, 0, -0.5674909, -0.8985808, 0, 0.9281671, 0, -0.02308917, 0.5674909, 0, -0.7344714, -0.27763766, -1.1526358, 0, -0.007543761, -0.51823056, 0, 1.1526605, 0, -0.02308917, 0.007543761, 0, -1.1526358, -0.9798754, 0.8091383, 0, -0.3941076, 0.67079794, 0, 0.9000142, 0, -0.02308917, 0.3941076, 0, 0.8091383, -0.24437162, -0.2419261, 0, -0.9095018, 0.8682848, 0, 0.9411279, 0, -0.023089172, 0.9095018, 0, -0.2419261, -0.46068996, 0.62147063, 0, -0.721784, 0.2864418, 0, 0.95246935, 0, -0.02308917, 0.721784, 0, 0.62147063, 0.958243, -0.5683935, 0, 1.0377975, 0.024289161, 0, 1.183256, 0, -0.02308917, -1.0377975, 0, -0.5683935, -0.51641285, -0.680375, 0, -0.7061484, -0.61206496, 0, 0.98058945, 0, -0.02308917, 0.7061484, 0, -0.680375, -0.23010801, -1.1482781, 0, -0.18656902, 0.93792766, 0, 1.1633359, 0, -0.02308917, 0.18656902, 0, -1.1482781, -0.7038853, -0.6247382, 0, -0.6054797, 0.34038144, 0, 0.87000203, 0, -0.02308917, 0.6054797, 0, -0.6247382, 0.57448393, 0.7610954, 0, -0.6411524, 0.71715117, 0, 0.99515957, 0, -0.02308917, 0.6411524, 0, 0.7610954, -0.19292521, -0.4894821, 0, -0.92073965, 0.78447896, 0, 1.0427628, 0, -0.02308917, 0.92073965, 0, -0.4894821, 0.036485285, -1.1801327, 0, 0.18000479, -0.44638515, 0, 1.1937819, 0, -0.02308917, -0.18000479, 0, -1.1801327, 0.27765045, -1.0183449, 0, -0.032055046, -0.52263033, 0, 1.0188493, 0, -0.02308917, 0.032055046, 0, -1.0183449, -0.96479255, -0.9728805, 0, -0.52715623, -0.8927295, 0, 1.1065216, 0, -0.023089169, 0.52715623, 0, -0.9728805, 0.2877886, 0.72787565, 0, -0.54835737, -0.3621297, 0, 0.91131705, 0, -0.023089169, 0.54835737, 0, 0.72787565, 0.6967421)

