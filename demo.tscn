[sub_resource type="ShaderMaterial" id="ShaderMaterial_6ah6f"]
render_priority = 0
shader = SubResource("Shader_yw20h")
shader_parameter/albedo = Color(0, 0.13333334, 0.19215687, 1)
shader_parameter/albedo2 = Color(0.035880946, 0.26625398, 0.29412654, 1)
shader_parameter/metallic = 0.0
shader_parameter/roughness = 0.10000000475
shader_parameter/wave = SubResource("NoiseTexture2D_i0g27")
shader_parameter/texture_normal = SubResource("NoiseTexture2D_sg3tj")
