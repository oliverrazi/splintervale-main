    ROUGHNESS = roughness;
    NORMAL_MAP = normal_blend;

    // --- Transparenz: 1 = opak, 0 = unsichtbar ---
    // t = \"wie viel man durchsehen will\"
    ALPHA = 1.0 - t;
	ALPHA = 0.8;
}



